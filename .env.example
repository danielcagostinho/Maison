# Postgres (Neon, Supabase, Railway, or local)
# Pooled connection (used by app at runtime)
DATABASE_URL="postgresql://user:password@host/maison?sslmode=require"
# Direct connection (used by Prisma migrations only)
DIRECT_URL="postgresql://user:password@host/maison?sslmode=require"

# Clerk — https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Mobile → API endpoint
# In dev, point at your Next.js dev server (use your LAN IP, not localhost, when testing on device)
EXPO_PUBLIC_API_URL="http://localhost:3000"
