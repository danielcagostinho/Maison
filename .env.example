# Postgres — provisioned via the Vercel + Neon integration.
# Run `vercel env pull .env` to populate these from your Vercel project.
POSTGRES_PRISMA_URL="postgresql://...?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://..."

# Clerk — https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Mobile → API endpoint
# In dev, point at your Next.js dev server (use your LAN IP, not localhost, when testing on device)
EXPO_PUBLIC_API_URL="http://localhost:3000"
