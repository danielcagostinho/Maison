{
  "name": "@maison/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env.local -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env.local -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env.local -- prisma studio",
    "seed": "dotenv -e ../../.env.local -- tsx prisma/seed.ts",
    "seed:me": "dotenv -e ../../.env.local -- tsx prisma/seed-me.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
